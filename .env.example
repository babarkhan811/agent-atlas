# Copy to .env.local for local development. Never commit real values.
# M1–M4 need no environment variables. Variables below arrive with M5/M7.

# Base path for GitHub Pages builds ("/agent-atlas"); leave empty elsewhere.
BASE_PATH=

# M5 — Supabase (Auth + Postgres). Use a development project.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# M5 — Polar (sandbox/test mode only until launch).
# POLAR_ACCESS_TOKEN=
# POLAR_WEBHOOK_SECRET=
# POLAR_SERVER=sandbox
